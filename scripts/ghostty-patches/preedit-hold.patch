+/// sm patch (preedit-hold): show `display` (just-committed text plus any new composition) as
+/// preedit until the program's output moves the cursor, then show `after` (the new composition,
+/// or nothing). Call this instead of clearing the preedit when an input method commits, before
+/// sending the committed text to the pty.
+pub fn preeditHoldCallback(self: *Surface, display: []const u8, after: ?[]const u8) !void {
+    const display_preedit = try self.preeditFromText(display);
+    errdefer if (display_preedit) |p| self.alloc.free(p.codepoints);
+    const after_preedit = if (after) |text| try self.preeditFromText(text) else null;
+    errdefer if (after_preedit) |p| self.alloc.free(p.codepoints);
+
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+
+    if (self.renderer_state.preedit) |p| self.alloc.free(p.codepoints);
+    self.clearPreeditHold();
+    self.renderer_state.preedit = display_preedit;
+    const cursor = self.renderer_state.terminal.screens.active.cursor;
+    self.renderer_state.preedit_hold = .{ .after = after_preedit, .x = cursor.x, .y = cursor.y };
+    self.io.terminal.flags.dirty.preedit = true;
+    try self.queueRender();
+}
+
+/// Caller holds the renderer state lock.
+fn clearPreeditHold(self: *Surface) void {
+    if (self.renderer_state.preedit_hold) |hold| {
+        if (hold.after) |a| self.alloc.free(a.codepoints);
+        self.renderer_state.preedit_hold = null;
+    }
+}
+
+/// UTF-8 → preedit codepoints, as preeditCallback does. Null if nothing is drawable.
+fn preeditFromText(self: *Surface, text: []const u8) !?rendererpkg.State.Preedit {
+    const view = try std.unicode.Utf8View.init(text);
+    var it = view.iterator();
+    const Codepoint = rendererpkg.State.Preedit.Codepoint;
+    var codepoints: std.ArrayList(Codepoint) = .empty;
+    defer codepoints.deinit(self.alloc);
+    while (it.nextCodepoint()) |cp| {
+        const width: usize = @intCast(unicode.table.get(cp).width);
+        if (width <= 0) continue;
+        try codepoints.append(self.alloc, .{ .codepoint = cp, .wide = width >= 2 });
+    }
+    if (codepoints.items.len == 0) return null;
+    return .{ .codepoints = try codepoints.toOwnedSlice(self.alloc) };
+}

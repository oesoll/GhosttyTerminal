+/// sm patch (preedit-hold). Caller holds the renderer state lock.
+fn releasePreeditHold(self: *Termio) void {
+    const hold = self.renderer_state.preedit_hold orelse return;
+    const cursor = self.terminal.screens.active.cursor;
+    if (cursor.x == hold.x and cursor.y == hold.y) return;
+    if (self.renderer_state.preedit) |p| self.alloc.free(p.codepoints);
+    self.renderer_state.preedit = hold.after;
+    self.renderer_state.preedit_hold = null;
+    self.terminal.flags.dirty.preedit = true;
+}
+
 /// Process output from readdata but the lock is already held.
 fn processOutputLocked(self: *Termio, buf: []const u8) void {
+    // sm patch (preedit-hold): once this output has moved the cursor, the held commit has been
+    // echoed — swap the preedit in the same locked step, so no frame shows it twice or not at all.
+    defer self.releasePreeditHold();
+
     // Schedule a render. We can call this first because we have the lock.
     self.terminal_stream.handler.queueRender() catch unreachable;
 
